<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Secondary Adjustment Panel (Glassmorphism) -->
    <LinearLayout
        android:id="@+id/adjustmentPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/glass_background"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mainToolbarFrame"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Pen Sub-Tools -->
        <LinearLayout
            android:id="@+id/penTypeLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btn_tool_pen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@drawable/ic_pen"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_primary" />
            <View android:layout_width="12dp" android:layout_height="0dp"/>
            <ImageButton
                android:id="@+id/btn_tool_brush"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@android:drawable/ic_menu_gallery"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_primary" />
            <View android:layout_width="12dp" android:layout_height="0dp"/>
            <ImageButton
                android:id="@+id/btn_tool_pencil"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@android:drawable/ic_menu_edit"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Shapes Sub-Tools -->
        <LinearLayout
            android:id="@+id/shapeTypeLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/btn_shape_rect"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@drawable/ic_folder"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_primary" />
            <View android:layout_width="12dp" android:layout_height="0dp"/>
            <ImageButton
                android:id="@+id/btn_shape_circle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@drawable/circle_black"
                android:padding="10dp"
                android:scaleType="fitCenter"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Color & Size Controls -->
        <LinearLayout
            android:id="@+id/colorLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/colorIndicator"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_white_border"
                android:elevation="4dp"/>

            <View android:layout_width="16dp" android:layout_height="0dp"/>

            <View
                android:id="@+id/rainbowBar"
                android:layout_width="180dp"
                android:layout_height="28dp"
                android:background="@drawable/gradient_spectrum"
                android:elevation="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="Drag spectrum to change color"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

    <!-- Main Modern Floating Toolbar (Glassmorphism) -->
    <FrameLayout
        android:id="@+id/mainToolbarFrame"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:background="@drawable/glass_background"
        android:paddingHorizontal="12dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_hand"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@drawable/ic_drag_handle"
                android:contentDescription="Hand Tool"
                app:tint="@color/text_primary" />

            <View android:layout_width="8dp" android:layout_height="0dp"/>

            <ImageButton
                android:id="@+id/btn_pen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@drawable/ic_pen"
                app:tint="@color/text_primary" />

            <View android:layout_width="8dp" android:layout_height="0dp"/>

            <ImageButton
                android:id="@+id/btn_text"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/text_primary" />

            <View android:layout_width="8dp" android:layout_height="0dp"/>

            <ImageButton
                android:id="@+id/btn_shape"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@drawable/ic_folder"
                app:tint="@color/text_primary" />

            <View android:layout_width="8dp" android:layout_height="0dp"/>

            <ImageButton
                android:id="@+id/btn_eraser"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tool_button_background"
                android:src="@drawable/ic_eraser"
                app:tint="@color/text_primary" />

            <!-- Vertical Divider -->
            <View
                android:layout_width="1.5dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="12dp"
                android:background="@color/glass_stroke" />

            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_undo"
                android:padding="10dp"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btn_redo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_redo"
                android:padding="10dp"
                app:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/btn_clear"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear_all"
                android:padding="10dp"
                app:tint="@color/text_primary" />

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>