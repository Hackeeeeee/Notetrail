<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardBackgroundColor="@android:color/transparent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Separate Background for Blur -->
        <View
            android:id="@+id/glassBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#CC000000" />

        <LinearLayout
            android:id="@+id/myGlassCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Container for Status Badge (Right Aligned) -->
            <LinearLayout
                android:id="@+id/paperStatusContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/paperProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_incomplete"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:background="#FFF3E0"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Title (Left Aligned, taking remaining space) -->
            <TextView
                android:id="@+id/paperTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/paperStatusContainer"
                android:layout_centerVertical="true"
                tools:text="Paper 22 - Core Multiple Choice"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingEnd="8dp"
                android:paddingStart="0dp"/>

        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/glass_stroke"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"/>

        <!-- Action Buttons Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: Question Paper -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Question Paper"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/openPaperButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="View"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#000000"
                    android:layout_marginEnd="12dp"/>

                <ImageButton
                    android:id="@+id/printPaperButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_print"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/apple_blue"
                    android:contentDescription="Print QP"/>

                <ImageButton
                    android:id="@+id/downloadPaperButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/stat_sys_download"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Download QP"/>
            </LinearLayout>

            <!-- Row 2: Mark Scheme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mark Scheme"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/openMsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="View"
                    android:textSize="12sp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#000000"
                    android:layout_marginEnd="12dp"/>

                <ImageButton
                    android:id="@+id/printMsButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_print"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/apple_blue"
                    android:contentDescription="Print MS"/>

                <ImageButton
                    android:id="@+id/downloadMsButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@android:drawable/stat_sys_download"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Download MS"/>
            </LinearLayout>

        </LinearLayout>


        <!-- Marks Entry Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="#991A1A1A"
            android:padding="16dp"
            android:id="@+id/marksSection">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/marksDisplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Marks: - / -"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/enterMarksButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <!-- Note Entry Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/noteEntry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Add review notes (e.g. Needs revision)"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="@null"
                    android:minHeight="48dp"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"/>

                <ImageButton
                    android:id="@+id/btnNoteOk"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_check"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#FFFFFF"
                    android:visibility="gone"
                    android:contentDescription="Save Note"/>
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>