<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/main_bg">

        <!-- Toolbar/Header -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:titleTextColor="@color/text_primary"
            app:navigationIconTint="@color/text_primary" />

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/loadingProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="visible"
                android:indeterminateTint="@color/gradient_accent"/>

            <!-- 1. Main Content List (Visible by default) -->
            <LinearLayout
                android:id="@+id/mainContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Dynamic Session Header -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/sessionHeaderCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp"
                    app:cardBackgroundColor="@color/surface_primary"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    android:outlineAmbientShadowColor="@android:color/transparent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/sessionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="May/June 2026"
                            android:textColor="@color/text_primary"
                            android:textSize="28sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:id="@+id/nextExamTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loading_countdown"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Examination Series"
                            android:textColor="@color/text_secondary"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Search Bar -->
                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:background="@drawable/glass_card"
                    android:elevation="0dp"
                    app:iconifiedByDefault="false"
                    app:queryHint="Search Subjects..." />

                <!-- Filter Options -->
                <RadioGroup
                    android:id="@+id/filterRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/glass_card"
                    android:padding="4dp">
                    
                    <RadioButton
                        android:id="@+id/filterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/gradient_accent"
                        android:checked="true"
                        android:layout_marginEnd="16dp"/>
                        
                    <RadioButton
                        android:id="@+id/filterCore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Core"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/gradient_accent"
                        android:layout_marginEnd="16dp"/>
                        
                    <RadioButton
                        android:id="@+id/filterExtended"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Extended"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/gradient_accent"/>
                </RadioGroup>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        
                        <!-- Total Progress Card -->
                        <FrameLayout
                            android:id="@+id/totalProgressCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            android:clickable="true"
                            android:foreground="?android:attr/selectableItemBackground"
                            android:background="@drawable/glass_card">
                            
                            <TextView
                                android:id="@+id/totalProgressText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/total_papers_completed"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:gravity="center"
                                android:padding="20dp"/>
                        </FrameLayout>

                        <!-- Dynamic Subject Container -->
                        <LinearLayout
                            android:id="@+id/subjectsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="8dp"/>

                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Custom Sidebar Content -->

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/glass_background"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/sidebar_background">

        <!-- Sidebar Header with Logo -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Notetrail Logo" />

        </FrameLayout>

        <!-- User Profile Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:background="@android:color/transparent">

            <TextView

                android:id="@+id/navUserEmail"

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="user@example.com"

                android:textColor="@color/text_primary"

                android:textSize="16sp"

                android:textStyle="bold"/>


            <TextView

                android:layout_width="wrap_content"

                android:layout_height="wrap_content"

                android:text="Notetrail Student"

                android:textColor="@color/text_secondary"

                android:alpha="0.8"

                android:textSize="14sp"/>

        </LinearLayout>



        <ScrollView

            android:layout_width="match_parent"

            android:layout_height="0dp"

            android:layout_weight="1">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="16dp">



                <!-- Sync Section -->

                <Button

                    android:id="@+id/navSyncButton"

                    style="@style/Widget.MaterialComponents.Button.TextButton"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:text="Sync Now"

                    android:textColor="@color/gradient_accent"

                    app:icon="@android:drawable/stat_notify_sync"

                    app:iconTint="@color/gradient_accent" />



                <View

                    android:layout_width="match_parent"

                    android:layout_height="1dp"

                    android:background="@color/glass_stroke"

                    android:layout_marginTop="8dp"

                    android:layout_marginBottom="16dp"/>



                <!-- Analytics Section -->

                <Button

                    android:id="@+id/navAnalyticsButton"

                    style="@style/Widget.MaterialComponents.Button.TextButton"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:text="@string/menu_analytics"

                    android:textColor="@color/text_primary"

                    app:icon="@android:drawable/ic_menu_view"

                    app:iconTint="@color/text_primary" />



                <View

                    android:layout_width="match_parent"

                    android:layout_height="1dp"

                    android:background="@color/glass_stroke"

                    android:layout_marginTop="8dp"

                    android:layout_marginBottom="16dp"/>



                <!-- Groups Section -->

                <Button

                    android:id="@+id/navGroupsButton"

                    style="@style/Widget.MaterialComponents.Button.TextButton"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:text="Groups"

                    android:textColor="@color/text_primary"

                    app:icon="@android:drawable/ic_menu_myplaces"

                    app:iconTint="@color/text_primary" />



                <View

                    android:layout_width="match_parent"

                    android:layout_height="1dp"

                    android:background="@color/glass_stroke"

                    android:layout_marginTop="16dp"

                    android:layout_marginBottom="16dp"/>



                <!-- History Section -->

                <LinearLayout

                    android:id="@+id/historyHeader"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:orientation="horizontal"

                    android:gravity="center_vertical"

                    android:clickable="true"

                    android:foreground="?android:attr/selectableItemBackground"

                    android:paddingVertical="8dp">



                    <TextView

                        android:layout_width="0dp"

                        android:layout_weight="1"

                        android:layout_height="wrap_content"

                        android:text="@string/menu_history"

                        android:textSize="14sp"

                        android:textStyle="bold"

                        android:textColor="@color/gradient_accent"
                        android:textAllCaps="true"/>


                    <TextView

                        android:id="@+id/historyToggleIcon"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="▼"

                        android:textSize="16sp"

                        android:textColor="@color/text_primary"/>

                </LinearLayout>


                <TextView

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:text="Recently completed papers"

                    android:textSize="12sp"

                    android:textColor="@color/glass_text_secondary"

                    android:layout_marginBottom="8dp"/>



                <LinearLayout

                    android:id="@+id/historyListContainer"

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:visibility="gone"

                    android:animateLayoutChanges="true">


                    <TextView

                        android:id="@+id/emptyHistoryText"

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:text="@string/no_history"

                        android:fontFamily="sans-serif-light"

                        android:padding="8dp"

                        android:textColor="@color/glass_text_secondary"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>


        <View

            android:layout_width="match_parent"

            android:layout_height="1dp"

            android:background="@color/glass_stroke"/>


        <!-- Bottom Actions -->

        <LinearLayout

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="16dp">


            <Button

                android:id="@+id/navSettingsButton"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:text="Settings"

                style="@style/Widget.MaterialComponents.Button.TextButton"

                app:icon="@android:drawable/ic_menu_preferences"

                android:textColor="@color/text_primary"

                app:iconTint="@color/text_primary"

                android:layout_marginBottom="8dp"/>



            <Button

                android:id="@+id/navLogoutButton"

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:text="Logout"

                style="@style/Widget.MaterialComponents.Button.OutlinedButton"

                app:icon="@android:drawable/ic_lock_power_off"

                android:textColor="@color/text_primary"

                app:strokeColor="@color/text_primary"

                app:iconTint="@color/text_primary"

                android:layout_marginBottom="8dp"/>


            <TextView

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:text="@string/version_info"

                android:gravity="center"

                android:textSize="12sp"

                android:layout_marginTop="8dp"

                android:textColor="@color/glass_text_secondary"/>

        </LinearLayout>
    </LinearLayout>
    </com.google.android.material.navigation.NavigationView>


</androidx.drawerlayout.widget.DrawerLayout>