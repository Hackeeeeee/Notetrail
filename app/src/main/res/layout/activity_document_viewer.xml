<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DocumentViewerActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_primary">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/pdf_container_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.mechanicalaxiom.notetrail.AnnotationView
            android:id="@+id/annotation_overlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Magnifier View -->
        <androidx.cardview.widget.CardView
            android:id="@+id/magnifier_card"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_margin="16dp"
            android:visibility="gone"
            app:cardCornerRadius="60dp"
            app:cardElevation="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:id="@+id/magnifier_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <ProgressBar
            android:id="@+id/loadingProgressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:elevation="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Top Controls Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/top_controls_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardElevation="15dp"
            app:cardCornerRadius="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/top_controls_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="Go back" />

                <TextView
                    android:id="@+id/doc_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginStart="8dp"
                    app:layout_constraintStart_toEndOf="@+id/btn_back"
                    app:layout_constraintEnd_toStartOf="@id/btn_drawer"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageButton
                    android:id="@+id/btn_drawer"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_primary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:contentDescription="Open Navigation" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Timer Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/timer_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardCornerRadius="12dp"
            app:cardElevation="15dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/top_controls_card">

            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="00:00:00" />
        </androidx.cardview.widget.CardView>

        <androidx.media3.ui.PlayerView
            android:id="@+id/audio_player_view"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="@color/surface_primary"
            android:visibility="gone"
            android:elevation="10dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_controls_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:use_controller="true"
            app:show_timeout="0" />

        <!-- Bottom Controls Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/bottom_controls_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_primary"
            app:cardElevation="15dp"
            app:cardCornerRadius="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/bottom_controls_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="8dp">

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_media_pause"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_primary"
                    android:contentDescription="Play or Pause" />

                <ImageButton
                    android:id="@+id/btn_save"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_save"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_primary"
                    android:contentDescription="Save" />

                <ImageButton
                    android:id="@+id/btn_annotate"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_pen"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/text_primary"
                    android:visibility="gone"
                    android:contentDescription="Toggle Annotation" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Annotation Bar -->
        <androidx.cardview.widget.CardView
            android:id="@+id/annotation_bar_card"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="32dp"
            app:cardElevation="20dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_controls_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:id="@+id/scroll_container_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">

                <HorizontalScrollView
                    android:id="@+id/horizontal_scroll_container"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/annotationBar"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/glass_toolbar_bg"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="20dp">

                        <ImageView
                            android:id="@+id/iv_sync_status"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_cloud_sync"
                            app:tint="#4CAF50" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="12dp"
                            android:background="#22000000" />

                        <!-- Drag Handle -->
                        <ImageView
                            android:id="@+id/btn_drag_handle"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_drag_handle"
                            app:tint="#555555"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Drag Handle" />

                        <ImageButton
                            android:id="@+id/btn_pen_tool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_pen"
                            android:scaleType="centerInside"
                            app:tint="@color/text_primary"
                            android:contentDescription="Pen Tool" />

                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />

                        <ImageButton
                            android:id="@+id/btn_pencil_tool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_pen"
                            android:scaleType="centerInside"
                            app:tint="@color/text_secondary"
                            android:contentDescription="Pencil Tool" />

                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />

                        <ImageButton
                            android:id="@+id/btn_gel_pen_tool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_pen"
                            android:scaleType="centerInside"
                            app:tint="#00008B"
                            android:contentDescription="Gel Pen Tool" />

                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />

                        <ImageButton
                            android:id="@+id/btn_highlighter_tool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_highlighter"
                            android:scaleType="centerInside"
                            app:tint="#E1C617"
                            android:contentDescription="Highlighter Tool" />

                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />

                        <ImageButton
                            android:id="@+id/btn_shapes_tool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_shapes"
                            android:scaleType="centerInside"
                            app:tint="@color/text_primary"
                            android:contentDescription="Shapes Tool" />

                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />

                        <ImageButton
                            android:id="@+id/btn_text_tool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_add_textbox"
                            android:scaleType="centerInside"
                            app:tint="@color/text_primary"
                            android:contentDescription="Add Text" />

                        <Space android:layout_width="12dp" android:layout_height="wrap_content" />

                        <ImageButton
                            android:id="@+id/btn_eraser_tool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_eraser"
                            android:scaleType="centerInside"
                            app:tint="@color/text_primary"
                            android:contentDescription="Eraser Tool" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="@color/glass_stroke" />

                        <ImageButton
                            android:id="@+id/btn_color_picker"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_color_picker"
                            android:scaleType="centerInside"
                            app:tint="@color/text_primary"
                            android:contentDescription="Pick Color" />

                        <com.mechanicalaxiom.notetrail.ColorSpectrumView
                            android:id="@+id/color_spectrum_picker"
                            android:layout_width="120dp"
                            android:layout_height="32dp"
                            android:layout_marginHorizontal="8dp"
                            android:visibility="gone" />

                        <com.mechanicalaxiom.notetrail.ThicknessWheelView
                            android:id="@+id/thickness_wheel"
                            android:layout_width="60dp"
                            android:layout_height="48dp"
                            android:layout_marginHorizontal="8dp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="@color/glass_stroke" />

                        <ImageButton
                            android:id="@+id/btn_undo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_undo"
                            android:scaleType="centerInside"
                            app:tint="@color/text_primary"
                            android:contentDescription="Undo" />

                        <ImageButton
                            android:id="@+id/btn_clear_tool"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_clear_all"
                            android:scaleType="centerInside"
                            app:tint="@color/text_primary"
                            android:contentDescription="Clear All" />

                    </LinearLayout>
                </HorizontalScrollView>

                <ScrollView
                    android:id="@+id/vertical_scroll_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:scrollbars="none" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Navigation View (Acrobat Standard) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface_primary">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_annotations_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp" />

            <TextView
                android:id="@+id/tv_empty_annotations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No annotations yet"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>